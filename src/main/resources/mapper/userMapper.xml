<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.sdb.buzzfeed.mapper.UserMapper">

    <!--获取关注数量-->
    <select id="selectFollowsNumber" resultType="java.lang.Integer">
        SELECT follows_number
        FROM user
        WHERE user_id = #{userId}
    </select>

    <!--    查询活跃粉丝-->
    <select id="selectActiveFansByIds" resultType="java.lang.Long">
        SELECT user_id
        FROM user
        WHERE user_id IN
        <foreach collection="fansList" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND is_active = 1
    </select>

    <!--    判断是否是活跃粉丝-->
    <select id="isActive" resultType="java.lang.Integer">
        SELECT is_active
        FROM user
        where user_id = #{followId}
    </select>

    <!--    筛选出大V-->
    <select id="selectVbyId" resultType="java.lang.Long">
        SELECT user_id
        FROM user
        where user_id IN
        <foreach collection="follows" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND follower_number > 2
    </select>
</mapper>
