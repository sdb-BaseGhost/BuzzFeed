<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.sdb.buzzfeed.mapper.userMapper">

    <!--获取粉丝数量-->
    <select id="selectFollowsNumber" resultType="java.lang.Integer">
        SELECT follower_number
        FROM user
        WHERE user_id = #{userId}
    </select>

    <!-- 查询某个用户关注的所有用户ID -->
    <select id="selectFollowsByUserId" resultType="java.lang.Long">
        SELECT follow_user_id
        FROM user_follow
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

<!--    查询用户的所有粉丝-->
    <select id="selectFollowersByUserId" resultType="java.lang.Long">
        SELECT user_id
        FROM user_follow
        WHERE follow_user_id = #{userId}
        ORDER BY create_time DESC
    </select>

<!--    查询活跃粉丝-->
    <select id="selectActiveFansByIds" resultType="java.lang.Long">
        SELECT id
        FROM user
        WHERE id IN
        <foreach collection="fansList" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND is_active = 1
    </select>


    <select id="isActive" resultType="java.lang.Integer">
        SELECT is_active
        FROM user_info
        where user_id = #{followId}
    </select>

</mapper>
